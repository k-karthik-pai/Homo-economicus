{
  "name": "homo-economicus",
  "private": true,
  "version": "1.0.0",
  "description": "The rational mind for irrational times — AI-powered decision advisor grounded in scientific theories",
  "author": "Homo Economicus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pack": "node scripts/build-desktop.mjs --dir",
    "desktop:dist": "node scripts/build-desktop.mjs",
    "desktop:dist:win": "node scripts/build-desktop.mjs --win",
    "desktop:dist:mac": "node scripts/build-desktop.mjs --mac"
  },
  "build": {
    "appId": "com.homoeconomicus.app",
    "productName": "Homo Economicus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.10"
  }
}
